{
  "name": "muse-bgm",
  "version": "0.2.0",
  "private": true,
  "description": "音序 Muse — 从一句灵感，到你的背景音乐",
  "author": "Muse",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.cjs",
    "dist": "npm run build && electron-builder --win portable --x64",
    "desktop:smoke": "node scripts/desktop-smoke.cjs",
    "test:ui": "node scripts/ui-smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "studio.muse.bgm",
    "productName": "Muse BGM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "artifactName": "Muse-BGM-${version}-Windows.${ext}",
      "icon": "electron/assets/muse.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "Muse-BGM-${version}-Windows.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
